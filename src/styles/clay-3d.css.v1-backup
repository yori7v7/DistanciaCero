/* ============================================================
   CLAY-3D SYSTEM — Flutter Dashboard Style
   Every interactive element gets deep 3D extrusion
   ============================================================ */

/* ---- Global 3D base for all interactive elements ---- */
button, a.button, [role="button"] {
  position: relative;
  top: 0;
  transition: all 0.12s cubic-bezier(0.16, 1, 0.3, 1);
}

button:active, a.button:active {
  transform: translateY(3px) !important;
}

/* ---- 3D NAVIGATION BAR ---- */
.scene-portal {
  background: rgba(10, 2, 18, 0.85) !important;
  backdrop-filter: blur(24px) !important;
  -webkit-backdrop-filter: blur(24px) !important;
  border: 1px solid rgba(255, 255, 255, 0.06) !important;
  border-radius: 24px !important;
  box-shadow:
    0 8px 0 rgba(8, 1, 14, 0.4),
    0 12px 30px rgba(0, 0, 0, 0.5),
    inset 0 1px 0 rgba(255, 255, 255, 0.05) !important;
  padding: 8px 16px !important;
}

/* ---- 3D NAV ITEMS (scene links) ---- */
.scene-link {
  border-radius: 16px !important;
  padding: 10px 14px !important;
  font-weight: 700 !important;
  background: rgba(255, 255, 255, 0.03) !important;
  border: 1px solid rgba(255, 255, 255, 0.05) !important;
  color: var(--muted) !important;
  box-shadow:
    0 4px 0 rgba(0, 0, 0, 0.2),
    0 6px 12px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255,255,255,0.04) !important;
  transition: all 0.12s cubic-bezier(0.16, 1, 0.3, 1) !important;
}
.scene-link:hover {
  background: rgba(255, 122, 200, 0.12) !important;
  border-color: rgba(255, 122, 200, 0.25) !important;
  color: var(--pink-soft) !important;
  transform: translateY(-2px) !important;
  box-shadow:
    0 6px 0 rgba(100, 12, 40, 0.25),
    0 10px 20px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255,255,255,0.06) !important;
}
.scene-link:active,
.scene-current .scene-link {
  background: linear-gradient(135deg, rgba(255, 122, 200, 0.2), rgba(255, 23, 68, 0.15)) !important;
  color: white !important;
  border-color: rgba(255, 122, 200, 0.35) !important;
  transform: translateY(2px) !important;
  box-shadow:
    0 2px 0 rgba(80, 8, 30, 0.3),
    0 3px 6px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255,255,255,0.08) !important;
}

/* ---- 3D NAV ARROWS + SETTINGS ---- */
.scene-nav-arrow,
.scene-settings-gear {
  width: 42px !important;
  height: 42px !important;
  border-radius: 14px !important;
  background: rgba(255, 255, 255, 0.04) !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  color: var(--pink-soft) !important;
  display: grid !important;
  place-items: center !important;
  cursor: pointer !important;
  box-shadow:
    0 4px 0 rgba(0, 0, 0, 0.25),
    0 6px 14px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255,255,255,0.06) !important;
  transition: all 0.12s cubic-bezier(0.16, 1, 0.3, 1) !important;
}
.scene-nav-arrow:hover,
.scene-settings-gear:hover {
  background: rgba(255, 122, 200, 0.15) !important;
  border-color: rgba(255, 122, 200, 0.3) !important;
  transform: translateY(-2px) !important;
  box-shadow:
    0 6px 0 rgba(100, 12, 40, 0.3),
    0 10px 20px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255,255,255,0.08) !important;
}
.scene-nav-arrow:active,
.scene-settings-gear:active {
  transform: translateY(2px) !important;
  box-shadow:
    0 2px 0 rgba(80, 8, 30, 0.3),
    0 3px 6px rgba(0,0,0,0.3) !important;
}

/* ---- 3D SETTINGS DROPDOWN ---- */
.scene-settings-dropdown {
  background: rgba(10, 2, 18, 0.94) !important;
  backdrop-filter: blur(24px) !important;
  border: 1px solid rgba(255,255,255,0.06) !important;
  border-radius: 20px !important;
  box-shadow:
    0 8px 0 rgba(8, 1, 14, 0.35),
    0 16px 40px rgba(0,0,0,0.5),
    inset 0 1px 0 rgba(255,255,255,0.04) !important;
  overflow: hidden !important;
}
.scene-settings-item {
  background: transparent !important;
  border-radius: 12px !important;
  margin: 4px 6px !important;
  padding: 10px 14px !important;
  color: var(--muted) !important;
  font-weight: 700 !important;
  cursor: pointer !important;
  transition: all 0.15s ease !important;
}
.scene-settings-item:hover {
  background: rgba(255, 122, 200, 0.12) !important;
  color: var(--pink-soft) !important;
}

/* ---- 3D MAIN BUTTONS (CTA, Action) ---- */
.main-button,
.control-btn.submit-btn,
button.submit-btn {
  border-radius: 18px !important;
  padding: 16px 32px !important;
  font-weight: 800 !important;
  font-size: 1rem !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  background: linear-gradient(135deg, rgba(255, 122, 200, 0.35), rgba(255, 23, 68, 0.25)) !important;
  color: white !important;
  box-shadow:
    0 6px 0 rgba(160, 20, 60, 0.3),
    0 10px 24px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255,255,255,0.2) !important;
  cursor: pointer !important;
}
.main-button:hover,
.control-btn.submit-btn:hover {
  transform: translateY(-2px) !important;
  box-shadow:
    0 8px 0 rgba(160, 20, 60, 0.25),
    0 14px 32px rgba(0, 0, 0, 0.45),
    inset 0 1px 0 rgba(255,255,255,0.25) !important;
}
.main-button:active {
  transform: translateY(3px) !important;
  box-shadow:
    0 2px 0 rgba(160, 20, 60, 0.2),
    0 4px 8px rgba(0,0,0,0.3),
    inset 0 1px 0 rgba(255,255,255,0.15) !important;
}

/* ---- 3D GHOST / SECONDARY BUTTONS ---- */
.ghost-button,
.control-btn:not(.submit-btn):not(.active-sim):not(.inactive-sim):not(.reset-btn) {
  border-radius: 14px !important;
  padding: 12px 24px !important;
  font-weight: 700 !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  background: rgba(255, 255, 255, 0.03) !important;
  color: var(--pink-soft) !important;
  box-shadow:
    0 4px 0 rgba(0, 0, 0, 0.2),
    0 6px 14px rgba(0, 0, 0, 0.3),
    inset 0 1px 0 rgba(255,255,255,0.04) !important;
  cursor: pointer !important;
  transition: all 0.12s cubic-bezier(0.16, 1, 0.3, 1) !important;
}
.ghost-button:hover {
  background: rgba(255, 122, 200, 0.1) !important;
  border-color: rgba(255, 122, 200, 0.25) !important;
  transform: translateY(-2px) !important;
  box-shadow:
    0 6px 0 rgba(100, 12, 40, 0.2),
    0 10px 20px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255,255,255,0.06) !important;
}
.ghost-button:active {
  transform: translateY(2px) !important;
  box-shadow:
    0 2px 0 rgba(80, 8, 30, 0.2),
    0 3px 6px rgba(0,0,0,0.3) !important;
}

/* ---- 3D CARDS (all section cards) ---- */
.counter-card,
.control-card,
.letter-card,
.milanesa-card,
.secret-card,
.timeline-content,
.mini-card,
.song-card,
.message-box,
.reason-item,
.gallery-card,
.date-card,
.dream-step,
.promise-note,
.playlist-row,
.universe-card,
.capsule-card {
  border-radius: 24px !important;
  border: 1px solid rgba(255, 255, 255, 0.06) !important;
  background: rgba(18, 4, 28, 0.7) !important;
  backdrop-filter: blur(16px) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  box-shadow:
    0 6px 0 rgba(8, 1, 14, 0.3),
    0 16px 40px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255, 255, 255, 0.04) !important;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
  position: relative;
  top: 0;
}
.counter-card:hover,
.mini-card:hover,
.song-card:hover,
.gallery-card:hover,
.message-box:hover,
.date-card:hover,
.dream-step:hover,
.promise-note:hover {
  transform: translateY(-3px) !important;
  box-shadow:
    0 9px 0 rgba(8, 1, 14, 0.25),
    0 22px 50px rgba(0, 0, 0, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.06) !important;
  border-color: rgba(255, 122, 200, 0.2) !important;
}

/* ---- 3D COUNTER CARDS (special colored borders) ---- */
.counter-card {
  border: 1.5px solid rgba(255, 122, 200, 0.15) !important;
  background: linear-gradient(180deg, rgba(255,122,200,0.06), rgba(255,23,68,0.03), rgba(18,4,28,0.7)) !important;
  box-shadow:
    0 6px 0 rgba(160, 20, 60, 0.2),
    0 14px 30px rgba(0, 0, 0, 0.35),
    inset 0 1px 0 rgba(255,255,255,0.06),
    0 0 40px rgba(255,122,200,0.06) !important;
}

/* ---- 3D FLOATING MUSIC DOCK ---- */
.floating-music-dock {
  border-radius: 20px !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  background: rgba(10, 2, 18, 0.88) !important;
  backdrop-filter: blur(20px) !important;
  box-shadow:
    0 6px 0 rgba(8, 1, 14, 0.4),
    0 14px 35px rgba(0, 0, 0, 0.5),
    inset 0 1px 0 rgba(255,255,255,0.05) !important;
}
.music-dock-title,
.dock-button {
  border-radius: 14px !important;
  transition: all 0.12s cubic-bezier(0.16, 1, 0.3, 1) !important;
}
.dock-button {
  background: rgba(255, 255, 255, 0.03) !important;
  border: 1px solid rgba(255, 255, 255, 0.06) !important;
  box-shadow:
    0 3px 0 rgba(0,0,0,0.2),
    0 5px 10px rgba(0,0,0,0.25),
    inset 0 1px 0 rgba(255,255,255,0.04) !important;
}
.dock-button:hover {
  background: rgba(255, 122, 200, 0.15) !important;
  transform: translateY(-2px) !important;
  box-shadow:
    0 5px 0 rgba(100, 12, 40, 0.25),
    0 8px 18px rgba(0,0,0,0.35) !important;
}
.dock-button:active {
  transform: translateY(2px) !important;
  box-shadow: 0 1px 0 rgba(80,8,30,0.2), 0 2px 4px rgba(0,0,0,0.3) !important;
}

/* ---- 3D HERO CTA ---- */
.hero-actions .main-button {
  border-radius: 22px !important;
  padding: 18px 40px !important;
  font-size: 1.1rem !important;
  box-shadow:
    0 8px 0 rgba(160, 20, 60, 0.35),
    0 16px 36px rgba(0, 0, 0, 0.5),
    inset 0 2px 0 rgba(255,255,255,0.2) !important;
  border: 1px solid rgba(255, 255, 255, 0.12) !important;
}

/* ---- 3D MUSIC TOGGLE ---- */
.hero-music-toggle {
  border-radius: 14px !important;
  padding: 10px 18px !important;
  background: rgba(255, 255, 255, 0.03) !important;
  border: 1px solid rgba(255, 255, 255, 0.06) !important;
  box-shadow:
    0 3px 0 rgba(0,0,0,0.2),
    0 5px 12px rgba(0,0,0,0.3),
    inset 0 1px 0 rgba(255,255,255,0.04) !important;
  cursor: pointer !important;
  transition: all 0.12s cubic-bezier(0.16, 1, 0.3, 1) !important;
}
.hero-music-toggle:hover {
  transform: translateY(-2px) !important;
  box-shadow:
    0 5px 0 rgba(100, 12, 40, 0.2),
    0 8px 18px rgba(0,0,0,0.35) !important;
}
.hero-music-toggle:active {
  transform: translateY(2px) !important;
  box-shadow: 0 1px 0 rgba(80,8,30,0.2), 0 2px 4px rgba(0,0,0,0.3) !important;
}

/* ---- 3D EMERGENCY BUTTON ---- */
.floating-emergency-button {
  border-radius: 50% !important;
  width: 60px !important;
  height: 60px !important;
  background: linear-gradient(135deg, rgba(255, 122, 200, 0.3), rgba(255, 23, 68, 0.2)) !important;
  border: 1px solid rgba(255, 255, 255, 0.1) !important;
  box-shadow:
    0 6px 0 rgba(160, 20, 60, 0.3),
    0 10px 24px rgba(0, 0, 0, 0.4),
    inset 0 2px 0 rgba(255,255,255,0.2) !important;
}
.floating-emergency-button:active {
  transform: translateY(3px) scale(0.95) !important;
  box-shadow: 0 2px 0 rgba(160,20,60,0.2), 0 4px 8px rgba(0,0,0,0.3) !important;
}

/* ---- 3D BACK TO TOP ---- */
.back-to-top {
  width: 48px !important;
  height: 48px !important;
  border-radius: 16px !important;
  background: rgba(10, 2, 18, 0.85) !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  box-shadow:
    0 4px 0 rgba(0,0,0,0.3),
    0 8px 20px rgba(0,0,0,0.4),
    inset 0 1px 0 rgba(255,255,255,0.05) !important;
}
.back-to-top:hover {
  transform: translateY(-2px) !important;
  box-shadow:
    0 6px 0 rgba(100,12,40,0.25),
    0 12px 28px rgba(0,0,0,0.45) !important;
}

/* ---- Global: all inputs get 3D inset look ---- */
input, textarea, select {
  border-radius: 12px !important;
  border: 1px solid rgba(255, 255, 255, 0.08) !important;
  background: rgba(0, 0, 0, 0.3) !important;
  color: var(--white) !important;
  padding: 12px 16px !important;
  box-shadow:
    inset 0 2px 4px rgba(0, 0, 0, 0.4),
    0 1px 0 rgba(255,255,255,0.03) !important;
  transition: all 0.2s ease !important;
}
input:focus, textarea:focus, select:focus {
  border-color: rgba(255, 122, 200, 0.35) !important;
  box-shadow:
    inset 0 2px 4px rgba(0, 0, 0, 0.4),
    0 0 0 3px rgba(255, 122, 200, 0.1) !important;
  outline: none !important;
}
