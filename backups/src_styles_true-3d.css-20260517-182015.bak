.true-3d-card {
  position: relative;
  border: 1px solid rgba(255, 122, 200, 0.28);
  border-radius: 34px;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 20%, rgba(255, 23, 68, 0.1), transparent 30%),
    radial-gradient(circle at 80% 70%, rgba(255, 122, 200, 0.12), transparent 34%),
    rgba(5, 0, 10, 0.92);
  box-shadow:
    0 0 60px rgba(255, 23, 68, 0.16),
    inset 0 0 80px rgba(255, 255, 255, 0.025);
}

.true-3d-canvas {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  display: block !important;
}

.universe-3d-shell {
  height: clamp(720px, 82vh, 960px);
  min-height: 720px;
}

.true-3d-hud {
  position: absolute;
  z-index: 10;
  top: 18px;
  left: 18px;
  right: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  pointer-events: none;
}

.true-3d-hud span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  width: fit-content;
  padding: 8px 11px;
  border: 1px solid rgba(255, 122, 200, 0.25);
  border-radius: 999px;
  background: rgba(8, 0, 14, 0.64);
  color: var(--pink-soft);
  font-size: 0.76rem;
  font-weight: 900;
  letter-spacing: 0.6px;
  backdrop-filter: blur(10px);
  box-shadow: 0 0 18px rgba(255, 122, 200, 0.1);
}

.planet-3d-label,
.core-3d-label {
  border: 1px solid rgba(255, 122, 200, 0.34);
  background: rgba(8, 0, 14, 0.72);
  color: var(--pink-soft);
  backdrop-filter: blur(10px);
  cursor: pointer;
  font: inherit;
  font-weight: 900;
  box-shadow: 0 0 16px rgba(255, 122, 200, 0.14);
}

.planet-3d-label {
  padding: 8px 12px;
  border-radius: 999px;
  font-size: 0.78rem;
  white-space: nowrap;
  pointer-events: auto;
  transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
}

.planet-3d-label:hover,
.planet-3d-label-active,
.core-3d-label:hover,
.core-3d-label-active {
  color: white;
  border-color: rgba(255, 218, 240, 0.86);
  box-shadow: 0 0 28px rgba(255, 122, 200, 0.38);
}

.planet-3d-label:hover {
  transform: translateY(-2px);
}

.core-3d-label {
  width: 144px;
  height: 144px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 5px;
  border-radius: 999px;
  text-align: center;
  color: white;
  background:
    radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.25), transparent 30%),
    rgba(255, 23, 68, 0.22);
  pointer-events: auto;
}

.core-3d-label strong {
  font-size: 1.14rem;
}

.core-3d-label span {
  color: rgba(255, 255, 255, 0.8);
  font-size: 0.72rem;
}

.universe-selected-card {
  scroll-margin-top: 120px;
  width: min(100%, 1080px);
  margin: 28px auto 0;
  display: grid;
  grid-template-columns: minmax(240px, 0.38fr) minmax(0, 1fr);
  gap: 28px;
  border: 1px solid rgba(255, 122, 200, 0.28);
  border-radius: 30px;
  background:
    radial-gradient(circle at 18% 20%, rgba(255, 122, 200, 0.14), transparent 30%),
    rgba(9, 0, 15, 0.9);
  padding: clamp(20px, 4vw, 32px);
  box-shadow: 0 0 42px rgba(255, 23, 68, 0.13);
}

.universe-selected-orb {
  min-height: 280px;
  display: grid;
  place-items: center;
  border-radius: 24px;
  border: 1px solid rgba(255, 122, 200, 0.18);
  background:
    radial-gradient(circle at center, rgba(255, 122, 200, 0.18), transparent 36%),
    rgba(255, 255, 255, 0.035);
}

.universe-selected-orb span {
  width: min(55vw, 180px);
  aspect-ratio: 1;
  border-radius: 999px;
  background:
    radial-gradient(circle at 28% 25%, rgba(255, 255, 255, 0.34), transparent 24%),
    linear-gradient(145deg, var(--planet-a), var(--planet-b));
  box-shadow:
    0 0 58px rgba(255, 122, 200, 0.38),
    inset -20px -18px 34px rgba(0, 0, 0, 0.24);
}

.universe-selected-content {
  display: grid;
  align-content: center;
}

.universe-selected-content > span {
  color: var(--pink);
  text-transform: uppercase;
  letter-spacing: 1.8px;
  font-size: 0.84rem;
  font-weight: 900;
}

.universe-selected-content h3 {
  margin: 10px 0 12px;
  font-size: clamp(2rem, 4vw, 3.1rem);
}

.universe-selected-content p {
  color: var(--muted);
  line-height: 1.75;
  margin: 0 0 18px;
}

.universe-selected-content ul {
  margin: 0 0 24px;
  padding-left: 18px;
  display: grid;
  gap: 10px;
  color: var(--muted);
}

.universe-selected-content li::marker {
  color: var(--pink);
}

@media (max-width: 980px) {
  .universe-3d-shell {
    height: 760px;
    min-height: 760px;
  }

  .universe-selected-card {
    grid-template-columns: 1fr;
  }

  .universe-selected-orb {
    min-height: 220px;
  }
}

@media (max-width: 620px) {
  .true-3d-card {
    border-radius: 24px;
  }

  .universe-3d-shell {
    height: 640px;
    min-height: 640px;
  }

  .true-3d-hud span {
    font-size: 0.64rem;
    padding: 7px 9px;
  }

  .core-3d-label {
    width: 112px;
    height: 112px;
  }

  .planet-3d-label {
    font-size: 0.66rem;
  }
}
