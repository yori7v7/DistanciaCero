.true-3d-card {
  position: relative;
  border: 1px solid rgba(255, 122, 200, 0.28);
  border-radius: 34px;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 20%, rgba(255, 23, 68, 0.1), transparent 30%),
    radial-gradient(circle at 80% 70%, rgba(255, 122, 200, 0.12), transparent 34%),
    rgba(5, 0, 10, 0.92);
  box-shadow:
    0 0 55px rgba(255, 23, 68, 0.16),
    inset 0 0 70px rgba(255, 255, 255, 0.025);
}

.true-3d-canvas {
  width: 100% !important;
  height: 100% !important;
  display: block;
}

.universe-3d-shell {
  min-height: 900px;
}

.reasons-3d-shell {
  min-height: 860px;
}

.true-3d-hud {
  position: absolute;
  z-index: 10;
  top: 18px;
  left: 18px;
  right: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  pointer-events: none;
}

.true-3d-hud span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  width: fit-content;
  padding: 8px 11px;
  border: 1px solid rgba(255, 122, 200, 0.25);
  border-radius: 999px;
  background: rgba(8, 0, 14, 0.64);
  color: var(--pink-soft);
  font-size: 0.76rem;
  font-weight: 900;
  letter-spacing: 0.6px;
  backdrop-filter: blur(10px);
  box-shadow: 0 0 18px rgba(255, 122, 200, 0.1);
}

.planet-3d-label,
.core-3d-label,
.reason-3d-label {
  border: 1px solid rgba(255, 122, 200, 0.34);
  background: rgba(8, 0, 14, 0.72);
  color: var(--pink-soft);
  backdrop-filter: blur(10px);
  cursor: pointer;
  font: inherit;
  font-weight: 900;
  box-shadow: 0 0 16px rgba(255, 122, 200, 0.14);
}

.planet-3d-label {
  padding: 7px 11px;
  border-radius: 999px;
  font-size: 0.78rem;
  white-space: nowrap;
}

.planet-3d-label:hover,
.core-3d-label:hover,
.reason-3d-label:hover {
  color: white;
  border-color: rgba(255, 218, 240, 0.8);
  box-shadow: 0 0 26px rgba(255, 122, 200, 0.36);
}

.core-3d-label {
  width: 150px;
  height: 150px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 5px;
  border-radius: 999px;
  text-align: center;
  color: white;
  background:
    radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.25), transparent 30%),
    rgba(255, 23, 68, 0.22);
}

.core-3d-label strong {
  font-size: 1.2rem;
}

.core-3d-label span {
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.78rem;
}

.reason-3d-label {
  min-width: 38px;
  height: 32px;
  padding: 0 9px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-size: 0.76rem;
}

.reason-modal-true-3d {
  box-shadow:
    0 28px 85px rgba(0, 0, 0, 0.42),
    0 0 44px rgba(255, 122, 200, 0.14);
}

.universe-3d-info-backdrop {
  position: absolute;
  z-index: 20;
}

.universe-3d-info-card {
  grid-template-columns: 0.55fr 1.45fr;
}

.universe-3d-info-orb {
  min-height: 300px;
  display: grid;
  place-items: center;
  border-radius: 24px;
  border: 1px solid rgba(255, 122, 200, 0.14);
  background:
    radial-gradient(circle at center, rgba(255, 122, 200, 0.18), transparent 36%),
    rgba(255, 255, 255, 0.035);
}

.universe-3d-info-orb span {
  width: 170px;
  aspect-ratio: 1;
  border-radius: 999px;
  background:
    radial-gradient(circle at 28% 25%, rgba(255, 255, 255, 0.34), transparent 24%),
    linear-gradient(145deg, var(--planet-a), var(--planet-b));
  box-shadow:
    0 0 55px rgba(255, 122, 200, 0.38),
    inset -20px -18px 32px rgba(0, 0, 0, 0.24);
}

@media (max-width: 980px) {
  .universe-3d-shell {
    min-height: 760px;
  }

  .reasons-3d-shell {
    min-height: 760px;
  }

  .universe-3d-info-card {
    grid-template-columns: 1fr;
  }

  .universe-3d-info-orb {
    min-height: 220px;
  }
}

@media (max-width: 620px) {
  .true-3d-card {
    border-radius: 24px;
  }

  .universe-3d-shell {
    min-height: 620px;
  }

  .reasons-3d-shell {
    min-height: 680px;
  }

  .true-3d-hud {
    top: 12px;
    left: 12px;
    right: 12px;
  }

  .true-3d-hud span {
    font-size: 0.64rem;
    padding: 7px 9px;
  }

  .core-3d-label {
    width: 108px;
    height: 108px;
  }

  .core-3d-label strong {
    font-size: 0.9rem;
  }

  .planet-3d-label {
    font-size: 0.68rem;
  }
}
