/* =========================================================
   DISTANCIA CERO - UPGRADE 3D
   Universo + 100 razones + agujero negro
========================================================= */

/* -------------------------
   UNIVERSO 3D
------------------------- */

.space-3d-universe {
  position: relative;
  perspective: 1900px;
  transform-style: preserve-3d;
  isolation: isolate;
}

.space-3d-universe .solar-system {
  transform-style: preserve-3d;
  transform: rotateX(var(--universe-rotate-x, 14deg)) rotateY(var(--universe-rotate-y, -8deg));
  transition: transform 0.18s ease-out;
}

.space-nebula,
.reasons-nebula {
  position: absolute;
  border-radius: 999px;
  filter: blur(30px);
  pointer-events: none;
  opacity: 0.75;
}

.space-nebula-a {
  width: 320px;
  height: 320px;
  left: -90px;
  top: 60px;
  background: rgba(255, 122, 200, 0.17);
}

.space-nebula-b {
  width: 420px;
  height: 420px;
  right: -110px;
  top: 180px;
  background: rgba(255, 23, 68, 0.12);
}

.space-nebula-c {
  width: 280px;
  height: 280px;
  left: 34%;
  bottom: -80px;
  background: rgba(122, 76, 255, 0.12);
}

.space-starfield,
.reasons-starfield {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.space-star,
.reasons-star {
  position: absolute;
  border-radius: 999px;
  background: rgba(255, 235, 245, 0.95);
  box-shadow: 0 0 12px rgba(255, 179, 221, 0.8);
  animation: starTwinkle3d ease-in-out infinite;
}

.universe-core-3d {
  transform: translate(-50%, -50%) translateZ(100px) !important;
  box-shadow:
    0 0 80px rgba(255, 122, 200, 0.52),
    0 0 140px rgba(255, 23, 68, 0.28),
    0 18px 50px rgba(0, 0, 0, 0.24) !important;
}

.space-3d-universe .orbit-shell-3d {
  transform-style: preserve-3d;
  animation-name: orbitSpin3d !important;
}

.space-3d-universe .orbit-shell-3d .orbit-path {
  transform: rotateX(var(--orbit-tilt, 12deg)) translateZ(-18px);
  box-shadow:
    inset 0 0 25px rgba(255, 122, 200, 0.1),
    0 0 18px rgba(255, 122, 200, 0.07);
}

.space-3d-universe .orbit-shell-3d .planet-anchor {
  animation-name: counterOrbitSpin3d !important;
  transform-style: preserve-3d;
}

.space-3d-universe .orbit-shell-3d .planet-button {
  transform: translateZ(var(--planet-depth, 42px));
  transition: transform 0.25s ease, filter 0.25s ease;
}

.space-3d-universe .planet-anchor:hover .planet-button {
  transform: translateZ(calc(var(--planet-depth, 42px) + 16px)) translateY(-6px) scale(1.08);
}

.space-3d-universe .planet-label {
  transform: translateZ(34px);
  box-shadow:
    0 0 18px rgba(255, 122, 200, 0.18),
    0 12px 28px rgba(0, 0, 0, 0.22);
}

.space-3d-universe .planet-button,
.space-3d-universe .zoom-planet {
  transform-style: preserve-3d;
}

.space-3d-universe .planet-surface {
  box-shadow:
    0 0 35px rgba(255, 122, 200, 0.42),
    inset -16px -14px 28px rgba(0, 0, 0, 0.28),
    inset 10px 10px 18px rgba(255, 255, 255, 0.1);
}

.space-3d-universe .planet-button.has-ring .planet-ring,
.space-3d-universe .zoom-planet.has-ring .planet-ring {
  transform: rotateX(72deg) rotate(-20deg) scaleX(1.5);
  box-shadow:
    0 0 18px rgba(255, 214, 240, 0.28),
    0 0 34px rgba(255, 214, 240, 0.14);
}

.planet-zoom-card-3d {
  transform-style: preserve-3d;
  box-shadow:
    0 28px 80px rgba(0, 0, 0, 0.42),
    0 0 40px rgba(255, 122, 200, 0.1);
}

.planet-zoom-visual-3d {
  perspective: 1200px;
  transform-style: preserve-3d;
}

.planet-zoom-visual-3d .zoom-planet {
  transform: translateZ(70px) rotateX(16deg);
  box-shadow:
    0 0 55px rgba(255, 122, 200, 0.22);
}

@keyframes orbitSpin3d {
  from {
    transform: translate(-50%, -50%) rotateX(var(--orbit-tilt, 12deg)) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotateX(var(--orbit-tilt, 12deg)) rotate(360deg);
  }
}

@keyframes counterOrbitSpin3d {
  from {
    transform: translate(-50%, -50%) rotateX(calc(var(--orbit-tilt, 12deg) * -1)) rotate(0deg);
  }
  to {
    transform: translate(-50%, -50%) rotateX(calc(var(--orbit-tilt, 12deg) * -1)) rotate(-360deg);
  }
}

@keyframes starTwinkle3d {
  0%, 100% {
    opacity: 0.24;
    transform: scale(0.9);
  }
  50% {
    opacity: 1;
    transform: scale(1.45);
  }
}

/* -------------------------
   100 RAZONES 3D
------------------------- */

.space-3d-reasons {
  position: relative;
  perspective: 1800px;
  transform-style: preserve-3d;
  isolation: isolate;
}

.reasons-depth-stage {
  position: relative;
  min-height: 860px;
  border-radius: 26px;
  overflow: hidden;
  transform-style: preserve-3d;
  transform: rotateX(var(--reasons-tilt-x, 10deg)) rotateY(var(--reasons-tilt-y, -6deg));
  transition: transform 0.16s ease-out;
}

.reasons-nebula-a {
  width: 360px;
  height: 360px;
  left: -110px;
  top: 40px;
  background: rgba(255, 122, 200, 0.15);
}

.reasons-nebula-b {
  width: 420px;
  height: 420px;
  right: -120px;
  bottom: -60px;
  background: rgba(255, 23, 68, 0.12);
}

.space-3d-reasons .reasons-chaos-box {
  transform-style: preserve-3d;
  perspective: 1400px;
  background:
    radial-gradient(circle at center, rgba(255, 122, 200, 0.08), transparent 32%),
    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.05), transparent 20%),
    rgba(0, 0, 0, 0.14);
}

.space-3d-reasons .chaotic-heart.hyper-chaotic-heart {
  border: 1px solid rgba(255, 190, 230, 0.34) !important;
  background:
    radial-gradient(circle at 28% 24%, rgba(255, 255, 255, 0.38), transparent 24%),
    radial-gradient(circle at 68% 74%, rgba(255, 122, 200, 0.16), transparent 26%),
    linear-gradient(145deg, rgba(255, 122, 200, 0.96), rgba(255, 23, 68, 0.88)) !important;
  box-shadow:
    0 0 30px rgba(255, 122, 200, 0.28),
    0 14px 28px rgba(0, 0, 0, 0.22),
    inset -10px -10px 16px rgba(0, 0, 0, 0.16),
    inset 8px 8px 12px rgba(255, 255, 255, 0.08);
  backface-visibility: hidden;
  transform-style: preserve-3d;
}

.space-3d-reasons .chaotic-heart.hyper-chaotic-heart:hover {
  box-shadow:
    0 0 44px rgba(255, 122, 200, 0.6),
    0 20px 36px rgba(0, 0, 0, 0.22) !important;
}

.reason-modal-3d {
  transform-style: preserve-3d;
  box-shadow:
    0 26px 80px rgba(0, 0, 0, 0.36),
    0 0 36px rgba(255, 122, 200, 0.14);
}

.reason-modal-3d .reason-modal-heart {
  animation: reasonModalFloat3d 4.2s ease-in-out infinite;
}

@keyframes reasonModalFloat3d {
  0%, 100% {
    transform: translateY(0) translateZ(0) rotate(0deg);
  }
  50% {
    transform: translateY(-8px) translateZ(26px) rotate(6deg);
  }
}

/* -------------------------
   AGUJERO NEGRO -> más tiempo + más profundidad
------------------------- */

.blackhole-stage {
  perspective: 2200px !important;
  transform-style: preserve-3d !important;
}

.blackhole-glow,
.blackhole-spiral,
.blackhole-lens,
.blackhole-core,
.blackhole-orbit {
  transform-style: preserve-3d;
}

.blackhole-spiral {
  transform: rotateX(80deg) rotateZ(-12deg) translateZ(48px) !important;
  box-shadow:
    0 0 45px rgba(255, 122, 200, 0.22),
    0 0 100px rgba(255, 23, 68, 0.18);
}

.blackhole-lens {
  transform: rotateX(74deg) rotateZ(-8deg) translateZ(10px) !important;
}

.blackhole-core {
  transform: translateZ(110px) !important;
  box-shadow:
    inset 0 0 26px rgba(255, 122, 200, 0.14),
    0 0 42px rgba(255, 122, 200, 0.26),
    0 0 70px rgba(0, 0, 0, 0.92) !important;
}

.blackhole-orbit {
  transform: translateZ(18px);
}

.blackhole-transition {
  perspective: 1800px;
}

.blackhole-transition::before,
.blackhole-transition::after,
.blackhole-warp-lines span,
.blackhole-transition-ring-1,
.blackhole-transition-ring-2,
.blackhole-transition-ring-3,
.blackhole-transition-ring-4,
.blackhole-transition-core,
.blackhole-transition-text {
  animation-duration: 2.25s !important;
}

.blackhole-transition-text {
  text-shadow:
    0 0 24px rgba(255, 122, 200, 0.2),
    0 0 46px rgba(255, 23, 68, 0.08);
}

@media (max-width: 980px) {
  .space-3d-universe .solar-system {
    transform: rotateX(10deg) rotateY(-4deg);
  }

  .reasons-depth-stage {
    min-height: 920px;
  }
}

@media (max-width: 620px) {
  .space-3d-universe .solar-system,
  .reasons-depth-stage {
    transform: none !important;
  }

  .space-nebula-a,
  .space-nebula-b,
  .space-nebula-c,
  .reasons-nebula-a,
  .reasons-nebula-b {
    opacity: 0.5;
    filter: blur(36px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .space-star,
  .reasons-star,
  .reason-modal-3d .reason-modal-heart {
    animation: none !important;
  }

  .space-3d-universe .solar-system,
  .reasons-depth-stage {
    transform: none !important;
    transition: none !important;
  }
}
