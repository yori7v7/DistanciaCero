.scene-mode-enabled {
  scroll-behavior: smooth;
}

.scene-mode-enabled .section,
.scene-mode-enabled .hero.section {
  scroll-margin-top: 116px;
}

.scene-hidden {
  display: none !important;
}

.scene-visible {
  display: block !important;
  animation: sceneReveal 0.6s ease both;
}

.scene-portal {
  position: fixed;
  z-index: 82;
  top: 14px;
  left: 50%;
  width: min(1180px, calc(100vw - 28px));
  transform: translateX(-50%);
  display: grid;
  grid-template-columns: auto minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  padding: 10px;
  border: 1px solid rgba(255, 122, 200, 0.28);
  border-radius: 28px;
  background:
    radial-gradient(circle at 15% 20%, rgba(255, 122, 200, 0.16), transparent 30%),
    rgba(8, 0, 14, 0.72);
  box-shadow:
    0 0 38px rgba(255, 23, 68, 0.18),
    inset 0 0 34px rgba(255, 255, 255, 0.025);
  backdrop-filter: blur(18px);
}

.scene-portal-current {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 170px;
}

.scene-portal-orb {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: white;
  background:
    radial-gradient(circle at 30% 22%, rgba(255, 255, 255, 0.25), transparent 30%),
    linear-gradient(145deg, rgba(255, 122, 200, 0.94), rgba(255, 23, 68, 0.86));
  box-shadow: 0 0 22px rgba(255, 122, 200, 0.36);
}

.scene-portal-current span {
  display: block;
  color: var(--pink-soft);
  font-size: 0.64rem;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 1.2px;
}

.scene-portal-current strong {
  display: block;
  color: white;
  font-size: 0.95rem;
}

.scene-portal-links {
  display: flex;
  justify-content: center;
  gap: 7px;
  min-width: 0;
  overflow-x: auto;
  scrollbar-width: none;
}

.scene-portal-links::-webkit-scrollbar {
  display: none;
}

.scene-link,
.scene-portal-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 1px solid rgba(255, 122, 200, 0.22);
  border-radius: 999px;
  background: rgba(255, 122, 200, 0.07);
  color: var(--pink-soft);
  font: inherit;
  font-size: 0.78rem;
  font-weight: 900;
  white-space: nowrap;
  cursor: pointer;
  transition: transform 0.22s ease, border-color 0.22s ease, background 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
}

.scene-link {
  padding: 9px 11px;
}

.scene-link:hover,
.scene-link.active,
.scene-portal-actions button:hover {
  transform: translateY(-2px);
  color: white;
  border-color: rgba(255, 218, 240, 0.82);
  background: rgba(255, 122, 200, 0.14);
  box-shadow: 0 0 22px rgba(255, 122, 200, 0.24);
}

.scene-portal-actions {
  display: flex;
  gap: 7px;
}

.scene-portal-actions button {
  width: 40px;
  height: 40px;
  padding: 0;
}

.scene-title-card {
  display: none !important;
}

@keyframes sceneReveal {
  from {
    opacity: 0;
    transform: translateY(18px) scale(0.992);
    filter: blur(5px);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0);
  }
}

@media (max-width: 900px) {
  .scene-portal {
    grid-template-columns: 1fr auto;
  }

  .scene-portal-links {
    grid-column: 1 / -1;
    order: 3;
    justify-content: flex-start;
    max-height: 0;
    opacity: 0;
    pointer-events: none;
    transition: max-height 0.25s ease, opacity 0.25s ease;
  }

  .scene-portal-links.open {
    max-height: 120px;
    opacity: 1;
    pointer-events: auto;
    padding-top: 4px;
  }
}

@media (max-width: 620px) {
  .scene-portal {
    top: 10px;
    width: calc(100vw - 20px);
    border-radius: 22px;
  }

  .scene-portal-current {
    min-width: 0;
  }

  .scene-portal-current strong {
    font-size: 0.82rem;
  }
}
