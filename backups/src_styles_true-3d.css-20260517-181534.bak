.true-3d-card {
  position: relative;
  border: 1px solid rgba(255, 122, 200, 0.28);
  border-radius: 34px;
  overflow: hidden;
  background:
    radial-gradient(circle at 20% 20%, rgba(255, 23, 68, 0.1), transparent 30%),
    radial-gradient(circle at 80% 70%, rgba(255, 122, 200, 0.12), transparent 34%),
    rgba(5, 0, 10, 0.92);
  box-shadow:
    0 0 55px rgba(255, 23, 68, 0.16),
    inset 0 0 70px rgba(255, 255, 255, 0.025);
}

.true-3d-canvas {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  display: block !important;
}

.universe-3d-shell {
  height: clamp(680px, 78vh, 880px);
  min-height: 680px;
}

.true-3d-hud {
  position: absolute;
  z-index: 10;
  top: 18px;
  left: 18px;
  right: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  pointer-events: none;
}

.true-3d-hud span {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  width: fit-content;
  padding: 8px 11px;
  border: 1px solid rgba(255, 122, 200, 0.25);
  border-radius: 999px;
  background: rgba(8, 0, 14, 0.64);
  color: var(--pink-soft);
  font-size: 0.76rem;
  font-weight: 900;
  letter-spacing: 0.6px;
  backdrop-filter: blur(10px);
  box-shadow: 0 0 18px rgba(255, 122, 200, 0.1);
}

.planet-3d-label,
.core-3d-label {
  border: 1px solid rgba(255, 122, 200, 0.34);
  background: rgba(8, 0, 14, 0.72);
  color: var(--pink-soft);
  backdrop-filter: blur(10px);
  cursor: pointer;
  font: inherit;
  font-weight: 900;
  box-shadow: 0 0 16px rgba(255, 122, 200, 0.14);
}

.planet-3d-label {
  padding: 7px 11px;
  border-radius: 999px;
  font-size: 0.78rem;
  white-space: nowrap;
  pointer-events: auto;
}

.planet-3d-label:hover,
.planet-3d-label-active,
.core-3d-label:hover,
.core-3d-label-active {
  color: white;
  border-color: rgba(255, 218, 240, 0.8);
  box-shadow: 0 0 26px rgba(255, 122, 200, 0.36);
}

.core-3d-label {
  width: 132px;
  height: 132px;
  display: grid;
  place-items: center;
  align-content: center;
  gap: 5px;
  border-radius: 999px;
  text-align: center;
  color: white;
  background:
    radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.25), transparent 30%),
    rgba(255, 23, 68, 0.22);
  pointer-events: auto;
}

.core-3d-label strong {
  font-size: 1.06rem;
}

.core-3d-label span {
  color: rgba(255, 255, 255, 0.78);
  font-size: 0.72rem;
}

.universe-selected-card {
  scroll-margin-top: 120px;
  width: min(100%, 1040px);
  margin: 28px auto 0;
  display: grid;
  grid-template-columns: minmax(220px, 0.38fr) minmax(0, 1fr);
  gap: 28px;
  border: 1px solid rgba(255, 122, 200, 0.28);
  border-radius: 30px;
  background:
    radial-gradient(circle at 18% 20%, rgba(255, 122, 200, 0.14), transparent 30%),
    rgba(9, 0, 15, 0.88);
  padding: clamp(20px, 4vw, 30px);
  box-shadow: 0 0 42px rgba(255, 23, 68, 0.13);
}

.universe-selected-orb {
  min-height: 260px;
  display: grid;
  place-items: center;
  border-radius: 24px;
  border: 1px solid rgba(255, 122, 200, 0.18);
  background:
    radial-gradient(circle at center, rgba(255, 122, 200, 0.18), transparent 36%),
    rgba(255, 255, 255, 0.035);
}

.universe-selected-orb span {
  width: min(55vw, 165px);
  aspect-ratio: 1;
  border-radius: 999px;
  background:
    radial-gradient(circle at 28% 25%, rgba(255, 255, 255, 0.34), transparent 24%),
    linear-gradient(145deg, var(--planet-a), var(--planet-b));
  box-shadow:
    0 0 55px rgba(255, 122, 200, 0.38),
    inset -20px -18px 32px rgba(0, 0, 0, 0.24);
}

.universe-selected-content {
  display: grid;
  align-content: center;
}

.universe-selected-content > span {
  color: var(--pink);
  text-transform: uppercase;
  letter-spacing: 1.8px;
  font-size: 0.84rem;
  font-weight: 900;
}

.universe-selected-content h3 {
  margin: 10px 0 12px;
  font-size: clamp(2rem, 4vw, 3rem);
}

.universe-selected-content p {
  color: var(--muted);
  line-height: 1.75;
  margin: 0 0 18px;
}

.universe-selected-content ul {
  margin: 0 0 24px;
  padding-left: 18px;
  display: grid;
  gap: 10px;
  color: var(--muted);
}

.universe-selected-content li::marker {
  color: var(--pink);
}

.reasons-3d-chaos-shell {
  position: relative;
  border: 1px solid rgba(255, 122, 200, 0.28);
  border-radius: 34px;
  background:
    radial-gradient(circle at center, rgba(255, 122, 200, 0.1), transparent 36%),
    radial-gradient(circle at 14% 24%, rgba(255, 23, 68, 0.08), transparent 28%),
    rgba(7, 0, 12, 0.88);
  box-shadow: var(--shadow-pink);
  overflow: hidden;
  padding: 18px;
}

.reasons-chaos-hud {
  position: relative;
  inset: auto;
  margin-bottom: 14px;
}

.reasons-3d-chaos-box {
  position: relative;
  min-height: 980px;
  border-radius: 26px;
  overflow: hidden;
  perspective: 1350px;
  transform-style: preserve-3d;
  background:
    radial-gradient(circle at center, rgba(255, 122, 200, 0.08), transparent 32%),
    radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.05), transparent 20%),
    rgba(0, 0, 0, 0.14);
}

.reason-depth-heart {
  position: absolute !important;
  left: 0;
  top: 0;
  width: 62px !important;
  height: 62px !important;
  border: 1px solid rgba(255, 210, 235, 0.42) !important;
  border-radius: 50%;
  background:
    radial-gradient(circle at 27% 22%, rgba(255, 255, 255, 0.62), transparent 15%),
    radial-gradient(circle at 36% 32%, rgba(255, 196, 230, 0.52), transparent 23%),
    radial-gradient(circle at 72% 78%, rgba(100, 0, 44, 0.28), transparent 34%),
    linear-gradient(145deg, rgba(255, 122, 200, 0.96), rgba(255, 23, 68, 0.9)) !important;
  box-shadow:
    0 0 28px rgba(255, 122, 200, 0.34),
    0 16px 28px rgba(0, 0, 0, 0.32),
    inset -13px -13px 18px rgba(72, 0, 32, 0.32),
    inset 9px 9px 14px rgba(255, 255, 255, 0.16);
  will-change: transform, opacity, filter;
  transform-style: preserve-3d;
  backface-visibility: hidden;
}

.reason-depth-heart::before {
  content: "";
  position: absolute;
  inset: 9px 14px auto auto;
  width: 18px;
  height: 9px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.34);
  filter: blur(0.2px);
  transform: rotate(-22deg);
  pointer-events: none;
}

.reason-depth-heart::after {
  content: "";
  position: absolute;
  inset: -9px;
  border-radius: 50%;
  background: radial-gradient(circle at center, rgba(255, 122, 200, 0.22), transparent 64%);
  pointer-events: none;
}

.reason-depth-heart:hover {
  box-shadow:
    0 0 48px rgba(255, 122, 200, 0.76),
    0 24px 42px rgba(0, 0, 0, 0.32),
    inset -13px -13px 18px rgba(72, 0, 32, 0.32),
    inset 9px 9px 14px rgba(255, 255, 255, 0.16) !important;
}

.reason-modal-true-3d {
  box-shadow:
    0 28px 85px rgba(0, 0, 0, 0.42),
    0 0 44px rgba(255, 122, 200, 0.14);
}

@media (max-width: 980px) {
  .universe-3d-shell {
    height: 720px;
    min-height: 720px;
  }

  .universe-selected-card {
    grid-template-columns: 1fr;
  }

  .universe-selected-orb {
    min-height: 220px;
  }

  .reasons-3d-chaos-box {
    min-height: 1080px;
  }
}

@media (max-width: 620px) {
  .true-3d-card {
    border-radius: 24px;
  }

  .universe-3d-shell {
    height: 620px;
    min-height: 620px;
  }

  .true-3d-hud span {
    font-size: 0.64rem;
    padding: 7px 9px;
  }

  .core-3d-label {
    width: 104px;
    height: 104px;
  }

  .planet-3d-label {
    font-size: 0.66rem;
  }

  .reasons-3d-chaos-shell {
    padding: 12px;
  }

  .reasons-3d-chaos-box {
    min-height: 1160px;
  }

  .reason-depth-heart {
    width: 54px !important;
    height: 54px !important;
  }
}
