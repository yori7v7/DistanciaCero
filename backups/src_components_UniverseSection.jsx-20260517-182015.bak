import { Suspense, useEffect, useMemo, useRef, useState } from 'react'
import { Canvas, useFrame, useThree } from '@react-three/fiber'
import { Html, OrbitControls, Stars } from '@react-three/drei'
import * as THREE from 'three'
import SectionTitle from './SectionTitle'
import { ArrowLeft, MousePointer2, Sparkles, ZoomIn } from 'lucide-react'

const ORBIT_CONFIGS = [
  { radius: 4.8, speed: 0.12, flatten: 0.78, y: 0.18, phase: 0.22, tilt: 0.04, ring: false, moon: false },
  { radius: 6.35, speed: 0.104, flatten: 0.8, y: -0.18, phase: 1.4, tilt: -0.03, ring: true, moon: false },
  { radius: 8.1, speed: 0.093, flatten: 0.77, y: 0.34, phase: 2.42, tilt: 0.06, ring: false, moon: true },
  { radius: 10.15, speed: 0.082, flatten: 0.81, y: -0.38, phase: 3.55, tilt: -0.08, ring: false, moon: false },
  { radius: 12.3, speed: 0.074, flatten: 0.79, y: 0.48, phase: 4.48, tilt: 0.09, ring: true, moon: false },
  { radius: 14.7, speed: 0.066, flatten: 0.83, y: -0.42, phase: 5.44, tilt: -0.05, ring: false, moon: true },
  { radius: 17.3, speed: 0.058, flatten: 0.85, y: 0.24, phase: 0.94, tilt: 0.03, ring: true, moon: false },
]

function CameraRig({ focus, controlsRef }) {
  const { camera } = useThree()
  const desired = useRef(new THREE.Vector3(0, 8.2, 26)).current
  const target = useRef(new THREE.Vector3(0, 0, 0)).current

  useFrame(() => {
    if (focus) {
      const focusPoint = new THREE.Vector3(focus.position[0], focus.position[1], focus.position[2])

      desired.set(
        focus.position[0] + focus.offset[0],
        focus.position[1] + focus.offset[1],
        focus.position[2] + focus.offset[2],
      )

      camera.position.lerp(desired, 0.052)
      target.lerp(focusPoint, 0.07)
    } else {
      desired.set(0, 8.2, 26)
      camera.position.lerp(desired, 0.034)
      target.lerp(new THREE.Vector3(0, 0, 0), 0.04)
    }

    if (controlsRef.current) {
      controlsRef.current.target.copy(target)
      controlsRef.current.update()
    }
  })

  return null
}

function OrbitRing({ radius, flatten = 0.8, tilt = 0, opacity = 0.18 }) {
  return (
    <mesh rotation={[Math.PI / 2 + tilt, 0, 0]} scale={[1, flatten, 1]}>
      <torusGeometry args={[radius, 0.018, 12, 280]} />
      <meshBasicMaterial color="#ff84c8" transparent opacity={opacity} />
    </mesh>
  )
}

function PlanetGlow({ size, color }) {
  return (
    <mesh>
      <sphereGeometry args={[size * 1.3, 32, 32]} />
      <meshBasicMaterial color={color} transparent opacity={0.16} />
    </mesh>
  )
}

function PlanetVisual({ planet, size, config, active }) {
  const spinRef = useRef(null)
  const moonOrbitRef = useRef(null)

  useFrame(({ clock }) => {
    if (spinRef.current) {
      spinRef.current.rotation.y += 0.012
      spinRef.current.rotation.x = Math.sin(clock.elapsedTime * 0.5) * 0.04
    }

    if (moonOrbitRef.current) {
      moonOrbitRef.current.rotation.y += 0.02
    }
  })

  return (
    <group ref={spinRef}>
      <PlanetGlow size={size} color={planet.colorB || planet.colorA} />

      <mesh castShadow receiveShadow>
        <sphereGeometry args={[size, 64, 64]} />
        <meshPhysicalMaterial
          color={planet.colorA}
          emissive={planet.colorB || planet.colorA}
          emissiveIntensity={active ? 0.36 : 0.18}
          roughness={0.42}
          metalness={0.12}
          clearcoat={0.52}
          clearcoatRoughness={0.24}
          sheen={0.4}
          sheenColor={new THREE.Color(planet.colorB || planet.colorA)}
        />
      </mesh>

      <mesh>
        <sphereGeometry args={[size * 1.06, 40, 40]} />
        <meshBasicMaterial color="#ffd8ee" transparent opacity={0.08} />
      </mesh>

      <mesh position={[-size * 0.22, size * 0.16, size * 0.6]}>
        <sphereGeometry args={[size * 0.1, 18, 18]} />
        <meshBasicMaterial color="#fff6fb" transparent opacity={0.26} />
      </mesh>

      {config.ring && (
        <>
          <mesh rotation={[Math.PI / 2.45, 0.26, 0.08]}>
            <torusGeometry args={[size * 1.58, size * 0.082, 16, 200]} />
            <meshStandardMaterial
              color="#ffd8f1"
              emissive="#ff7ac8"
              emissiveIntensity={0.46}
              transparent
              opacity={0.78}
              roughness={0.3}
              metalness={0.18}
            />
          </mesh>

          <mesh rotation={[Math.PI / 2.45, 0.26, 0.08]}>
            <torusGeometry args={[size * 1.84, size * 0.024, 10, 180]} />
            <meshBasicMaterial color="#fff3fa" transparent opacity={0.26} />
          </mesh>
        </>
      )}

      {config.moon && (
        <group ref={moonOrbitRef}>
          <mesh position={[size * 2.2, 0, 0]}>
            <sphereGeometry args={[size * 0.22, 24, 24]} />
            <meshStandardMaterial
              color="#ffd8f1"
              emissive="#ff7ac8"
              emissiveIntensity={0.2}
              roughness={0.46}
            />
          </mesh>
        </group>
      )}
    </group>
  )
}

function Planet3D({ planet, index, activeId, onSelect }) {
  const orbitRef = useRef(null)
  const config = ORBIT_CONFIGS[index] || {
    radius: 5 + index * 2.2,
    speed: 0.08,
    flatten: 0.8,
    y: 0,
    phase: index,
    tilt: 0,
    ring: false,
    moon: false,
  }

  const size = Math.max(0.58, Math.min(1.12, planet.size / 64))

  useFrame(({ clock }) => {
    const t = clock.elapsedTime * config.speed + config.phase
    const x = Math.cos(t) * config.radius
    const z = Math.sin(t) * config.radius * config.flatten
    const y = config.y + Math.sin(t * 1.26 + index * 0.8) * 0.18

    if (orbitRef.current && activeId !== planet.id) {
      orbitRef.current.position.set(x, y, z)
    }
  })

  const pickPlanet = (event) => {
    event.stopPropagation()

    const world = new THREE.Vector3()
    orbitRef.current?.getWorldPosition(world)

    onSelect(
      planet,
      [world.x, world.y, world.z],
      [0, 1.6, 5.7]
    )
  }

  return (
    <>
      <OrbitRing
        radius={config.radius}
        flatten={config.flatten}
        tilt={config.tilt}
        opacity={activeId === planet.id ? 0.34 : 0.14}
      />

      <group ref={orbitRef}>
        <group onClick={pickPlanet}>
          <PlanetVisual
            planet={planet}
            size={size}
            config={config}
            active={activeId === planet.id}
          />
        </group>

        <Html center distanceFactor={8.8} position={[0, -size - 0.6, 0]}>
          <button
            className={`planet-3d-label ${activeId === planet.id ? 'planet-3d-label-active' : ''}`}
            type="button"
            onClick={pickPlanet}
          >
            {planet.name}
          </button>
        </Html>
      </group>
    </>
  )
}

function CenterStar({ center, activeId, onSelect }) {
  const starRef = useRef(null)
  const haloRef = useRef(null)

  useFrame(({ clock }) => {
    if (starRef.current) {
      starRef.current.rotation.y += 0.005
      starRef.current.scale.setScalar(1 + Math.sin(clock.elapsedTime * 1.25) * 0.018)
    }

    if (haloRef.current) {
      haloRef.current.scale.setScalar(1.06 + Math.sin(clock.elapsedTime * 1.1) * 0.03)
    }
  })

  const pickCenter = (event) => {
    event.stopPropagation()

    onSelect(
      {
        ...center,
        id: 'ale-yori-core',
        isCenter: true,
        colorA: '#ff84c8',
        colorB: '#ff275f',
        hasRing: false,
        features: center.features || [],
      },
      [0, 0, 0],
      [0, 2.2, 7.4],
    )
  }

  return (
    <group>
      <mesh ref={starRef} onClick={pickCenter} castShadow receiveShadow>
        <sphereGeometry args={[2.12, 72, 72]} />
        <meshPhysicalMaterial
          color="#ff5cab"
          emissive="#ff275f"
          emissiveIntensity={0.9}
          roughness={0.24}
          metalness={0.12}
          clearcoat={0.62}
          clearcoatRoughness={0.18}
        />
      </mesh>

      <mesh ref={haloRef}>
        <sphereGeometry args={[2.8, 48, 48]} />
        <meshBasicMaterial color="#ff84c8" transparent opacity={0.1} />
      </mesh>

      <Html center distanceFactor={10.5} position={[0, 0, 0]}>
        <button
          className={`core-3d-label ${activeId === 'ale-yori-core' ? 'core-3d-label-active' : ''}`}
          type="button"
          onClick={pickCenter}
        >
          <Sparkles size={18} />
          <strong>Ale & Yori</strong>
          <span>El centro</span>
        </button>
      </Html>
    </group>
  )
}

function UniverseScene({ universe, activeWorld, cameraFocus, onSelect }) {
  const controlsRef = useRef(null)
  const planets = useMemo(() => universe.planets || [], [universe])
  const center = universe.center || {}

  return (
    <>
      <color attach="background" args={['#040008']} />
      <fog attach="fog" args={['#040008', 30, 58]} />

      <ambientLight intensity={0.82} />
      <pointLight position={[0, 0, 0]} intensity={14} color="#ff84c8" />
      <pointLight position={[8, 10, 12]} intensity={3.4} color="#ffffff" />
      <pointLight position={[-12, -6, -10]} intensity={2.1} color="#7c4cff" />

      <Stars radius={120} depth={60} count={1800} factor={4.8} saturation={0} fade speed={0.2} />

      <CenterStar center={center} activeId={activeWorld?.id} onSelect={onSelect} />

      {planets.map((planet, index) => (
        <Planet3D
          key={planet.id}
          planet={planet}
          index={index}
          activeId={activeWorld?.id}
          onSelect={onSelect}
        />
      ))}

      <CameraRig focus={cameraFocus} controlsRef={controlsRef} />

      <OrbitControls
        ref={controlsRef}
        enableZoom
        enablePan={false}
        minDistance={7}
        maxDistance={34}
        rotateSpeed={0.55}
        zoomSpeed={0.72}
        dampingFactor={0.08}
        enableDamping
      />
    </>
  )
}

function UniverseSection({ universe }) {
  const [activeWorld, setActiveWorld] = useState(null)
  const [cameraFocus, setCameraFocus] = useState(null)
  const [showDetails, setShowDetails] = useState(false)
  const detailsRef = useRef(null)
  const systemRef = useRef(null)
  const timerRef = useRef(null)

  useEffect(() => {
    return () => {
      if (timerRef.current) clearTimeout(timerRef.current)
    }
  }, [])

  const selectPlanet = (planet, position, offset) => {
    if (timerRef.current) clearTimeout(timerRef.current)

    setShowDetails(false)
    setActiveWorld(planet)
    setCameraFocus({ position, offset })

    timerRef.current = setTimeout(() => {
      setShowDetails(true)

      setTimeout(() => {
        detailsRef.current?.scrollIntoView({
          behavior: 'smooth',
          block: 'center',
        })
      }, 140)
    }, 950)
  }

  const closePlanet = () => {
    if (timerRef.current) clearTimeout(timerRef.current)

    setShowDetails(false)
    setActiveWorld(null)
    setCameraFocus(null)

    setTimeout(() => {
      systemRef.current?.scrollIntoView({
        behavior: 'smooth',
        block: 'center',
      })
    }, 140)
  }

  return (
    <section className="section" id="universo">
      <SectionTitle
        eyebrow="Universo Ale & Yori"
        title="Ale, este es el sistema solar que imaginé para nosotros"
        text="Quise que cada planeta se sintiera más vivo, más bonito y más nuestro, como si realmente existiera allá afuera."
      />

      <div className="true-3d-card universe-3d-shell fade-up" ref={systemRef}>
        <div className="true-3d-hud">
          <span>
            <ZoomIn size={16} />
            Zoom con la ruedita
          </span>
          <span>
            <MousePointer2 size={16} />
            Arrastra para girar
          </span>
          <span>
            <Sparkles size={16} />
            Toca un planeta
          </span>
        </div>

        <Canvas className="true-3d-canvas" shadows camera={{ position: [0, 8.2, 26], fov: 44 }}>
          <Suspense fallback={null}>
            <UniverseScene
              universe={universe}
              activeWorld={activeWorld}
              cameraFocus={cameraFocus}
              onSelect={selectPlanet}
            />
          </Suspense>
        </Canvas>
      </div>

      {activeWorld && showDetails && (
        <article className="universe-selected-card fade-up" ref={detailsRef}>
          <div
            className="universe-selected-orb"
            style={{ '--planet-a': activeWorld.colorA, '--planet-b': activeWorld.colorB }}
          >
            <span></span>
          </div>

          <div className="universe-selected-content">
            <span>{activeWorld.type}</span>
            <h3>{activeWorld.name}</h3>
            <p>{activeWorld.description}</p>

            <ul>
              {(activeWorld.features || []).map((feature, index) => (
                <li key={index}>{feature}</li>
              ))}
            </ul>

            <button className="main-button planet-back-button" type="button" onClick={closePlanet}>
              <ArrowLeft size={18} />
              Cerrar planeta
            </button>
          </div>
        </article>
      )}
    </section>
  )
}

export default UniverseSection
