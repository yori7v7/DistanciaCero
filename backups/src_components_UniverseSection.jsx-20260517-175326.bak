import { Suspense, useMemo, useRef, useState } from 'react'
import { Canvas, useFrame, useThree } from '@react-three/fiber'
import { Html, OrbitControls, Stars } from '@react-three/drei'
import * as THREE from 'three'
import SectionTitle from './SectionTitle'
import { ArrowLeft, MousePointer2, Sparkles, ZoomIn } from 'lucide-react'

function CameraRig({ focus, controlsRef }) {
  const { camera } = useThree()
  const target = useMemo(() => new THREE.Vector3(0, 0, 0), [])
  const desired = useMemo(() => new THREE.Vector3(0, 7, 15), [])

  useFrame(() => {
    if (!focus) return

    target.set(focus.position[0], focus.position[1], focus.position[2])
    desired.set(
      focus.position[0] + focus.offset[0],
      focus.position[1] + focus.offset[1],
      focus.position[2] + focus.offset[2],
    )

    camera.position.lerp(desired, 0.045)

    if (controlsRef.current) {
      controlsRef.current.target.lerp(target, 0.065)
      controlsRef.current.update()
    }
  })

  return null
}

function OrbitRing({ radius, color = '#ff7ac8', tilt = 0 }) {
  return (
    <mesh rotation={[Math.PI / 2 + tilt, 0, 0]}>
      <torusGeometry args={[radius, 0.008, 8, 180]} />
      <meshBasicMaterial color={color} transparent opacity={0.24} />
    </mesh>
  )
}

function Planet3D({ planet, index, activeId, onSelect }) {
  const groupRef = useRef(null)
  const planetRef = useRef(null)

  const radius = Math.max(2.7, planet.orbit / 86)
  const speed = 0.22 * (18 / Math.max(planet.duration || 18, 8))
  const start = (planet.delay || 0) + index * 0.85
  const size = Math.max(0.32, planet.size / 70)
  const tilt = (index % 4) * 0.09

  useFrame(({ clock }) => {
    const t = clock.elapsedTime * speed + start
    const x = Math.cos(t) * radius
    const z = Math.sin(t) * radius
    const y = Math.sin(t * 1.7 + index) * 0.18

    if (groupRef.current) {
      groupRef.current.position.set(x, y, z)
    }

    if (planetRef.current) {
      planetRef.current.rotation.y += 0.01
      planetRef.current.rotation.x = Math.sin(clock.elapsedTime * 0.6 + index) * 0.08
    }
  })

  const pickPlanet = (event) => {
    event.stopPropagation()

    const world = new THREE.Vector3()
    groupRef.current?.getWorldPosition(world)

    onSelect(planet, [world.x, world.y, world.z], {
      offset: [0, 1.7, 4.8],
    })
  }

  return (
    <>
      <OrbitRing radius={radius} tilt={tilt} />

      <group ref={groupRef}>
        <mesh ref={planetRef} onClick={pickPlanet}>
          <sphereGeometry args={[size, 48, 48]} />
          <meshStandardMaterial
            color={planet.colorA}
            emissive={planet.colorB}
            emissiveIntensity={activeId === planet.id ? 0.55 : 0.22}
            roughness={0.42}
            metalness={0.18}
          />
        </mesh>

        {planet.hasRing && (
          <mesh rotation={[Math.PI / 2.4, 0.25, 0]}>
            <torusGeometry args={[size * 1.35, 0.035, 12, 96]} />
            <meshStandardMaterial
              color="#ffd6f0"
              emissive="#ff7ac8"
              emissiveIntensity={0.35}
              transparent
              opacity={0.76}
            />
          </mesh>
        )}

        <Html center distanceFactor={8} position={[0, -size - 0.35, 0]}>
          <button className="planet-3d-label" type="button" onClick={pickPlanet}>
            {planet.name}
          </button>
        </Html>
      </group>
    </>
  )
}

function CenterStar({ center, onSelect }) {
  const ref = useRef(null)

  useFrame(({ clock }) => {
    if (!ref.current) return
    ref.current.rotation.y += 0.006
    ref.current.scale.setScalar(1 + Math.sin(clock.elapsedTime * 1.4) * 0.025)
  })

  const openCenter = (event) => {
    event.stopPropagation()
    onSelect(
      {
        ...center,
        id: 'ale-yori-core',
        isCenter: true,
        colorA: '#ff7ac8',
        colorB: '#ff1744',
        hasRing: false,
        features: center.features || [],
      },
      [0, 0, 0],
      { offset: [0, 2.4, 6.2] },
    )
  }

  return (
    <group>
      <mesh ref={ref} onClick={openCenter}>
        <sphereGeometry args={[1.75, 64, 64]} />
        <meshStandardMaterial
          color="#ff4fa3"
          emissive="#ff1744"
          emissiveIntensity={0.72}
          roughness={0.28}
          metalness={0.18}
        />
      </mesh>

      <mesh>
        <sphereGeometry args={[2.08, 48, 48]} />
        <meshBasicMaterial color="#ff7ac8" transparent opacity={0.09} />
      </mesh>

      <Html center distanceFactor={9} position={[0, 0, 0]}>
        <button className="core-3d-label" type="button" onClick={openCenter}>
          <Sparkles size={20} />
          <strong>Ale & Yori</strong>
          <span>El centro</span>
        </button>
      </Html>
    </group>
  )
}

function UniverseScene({ universe, activeWorld, setActiveWorld, setCameraFocus }) {
  const controlsRef = useRef(null)
  const planets = universe.planets || []
  const center = universe.center || {}

  const selectWorld = (world, position, config = {}) => {
    setActiveWorld(world)
    setCameraFocus({
      position,
      offset: config.offset || [0, 1.8, 5],
    })
  }

  return (
    <>
      <color attach="background" args={['#050008']} />

      <ambientLight intensity={0.58} />
      <pointLight position={[0, 0, 0]} intensity={8.5} color="#ff7ac8" />
      <pointLight position={[5, 6, 8]} intensity={2.2} color="#ffffff" />
      <pointLight position={[-8, -3, -5]} intensity={1.6} color="#ff1744" />

      <Stars radius={80} depth={40} count={900} factor={4} saturation={0} fade speed={0.25} />

      <CenterStar center={center} onSelect={selectWorld} />

      {planets.map((planet, index) => (
        <Planet3D
          key={planet.id}
          planet={planet}
          index={index}
          activeId={activeWorld?.id}
          onSelect={selectWorld}
        />
      ))}

      <CameraRig focus={null} controlsRef={controlsRef} />

      <OrbitControls
        ref={controlsRef}
        enableZoom
        enablePan={false}
        minDistance={4}
        maxDistance={25}
        rotateSpeed={0.62}
        zoomSpeed={0.8}
        dampingFactor={0.08}
        enableDamping
      />
    </>
  )
}

function UniverseSection({ universe }) {
  const [activeWorld, setActiveWorld] = useState(null)
  const [cameraFocus, setCameraFocus] = useState(null)

  const closeWorld = () => {
    setActiveWorld(null)
    setCameraFocus(null)
  }

  return (
    <section className="section" id="universo">
      <SectionTitle
        eyebrow="Universo Ale & Yori"
        title="Ale, este es el sistema solar que imaginé para nosotros"
        text="Ahora sí puedes acercarte, alejarte y mover este universo como si estuvieras viendo todo lo que somos desde afuera."
      />

      <div className="true-3d-card universe-3d-shell fade-up">
        <div className="true-3d-hud">
          <span>
            <ZoomIn size={16} />
            Zoom con la ruedita
          </span>
          <span>
            <MousePointer2 size={16} />
            Arrastra para girar
          </span>
          <span>
            <Sparkles size={16} />
            Toca un planeta
          </span>
        </div>

        <Canvas className="true-3d-canvas" camera={{ position: [0, 7, 15], fov: 48 }}>
          <Suspense fallback={null}>
            <UniverseScene
              universe={universe}
              activeWorld={activeWorld}
              setActiveWorld={setActiveWorld}
              setCameraFocus={setCameraFocus}
            />
            <CameraRig focus={cameraFocus} controlsRef={{ current: null }} />
          </Suspense>
        </Canvas>

        {activeWorld && (
          <div className="planet-modal-backdrop universe-3d-info-backdrop" onClick={closeWorld}>
            <div className="planet-zoom-card universe-3d-info-card" onClick={(event) => event.stopPropagation()}>
              <div className="universe-3d-info-orb" style={{ '--planet-a': activeWorld.colorA, '--planet-b': activeWorld.colorB }}>
                <span></span>
              </div>

              <div className="zoom-panel">
                <span className="zoom-eyebrow">{activeWorld.type}</span>
                <h3>{activeWorld.name}</h3>
                <p>{activeWorld.description}</p>

                <ul className="planet-detail-list">
                  {(activeWorld.features || []).map((feature, index) => (
                    <li key={index}>{feature}</li>
                  ))}
                </ul>

                <button className="main-button planet-back-button" type="button" onClick={closeWorld}>
                  <ArrowLeft size={18} />
                  Volver al sistema
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>
  )
}

export default UniverseSection
