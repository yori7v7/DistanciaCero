import { useEffect, useMemo, useRef, useState } from 'react'
import SectionTitle from './SectionTitle'
import { Heart, X } from 'lucide-react'

const BALL_SIZE = 62
const RADIUS = BALL_SIZE / 2
const MAX_SPEED = 1.3
const JITTER = 0.012
const MIN_Z = -90
const MAX_Z = 150

function clampSpeed(value, limit) {
  if (value > limit) return limit
  if (value < -limit) return -limit
  return value
}

function ReasonsSection({ reasons }) {
  const [selectedReason, setSelectedReason] = useState(null)
  const [tilt, setTilt] = useState({ x: 10, y: -6 })

  const selectedReasonRef = useRef(null)
  const containerRef = useRef(null)
  const itemRefs = useRef([])
  const animationRef = useRef(null)
  const objectsRef = useRef([])

  const stars = useMemo(
    () =>
      Array.from({ length: 34 }, (_, index) => ({
        id: index,
        left: `${Math.random() * 100}%`,
        top: `${Math.random() * 100}%`,
        size: `${Math.random() * 3 + 1}px`,
        delay: `${Math.random() * 3.2}s`,
        duration: `${Math.random() * 3.5 + 2.2}s`,
      })),
    [],
  )

  useEffect(() => {
    selectedReasonRef.current = selectedReason
  }, [selectedReason])

  useEffect(() => {
    const container = containerRef.current
    if (!container || !reasons?.length) return

    const createObjects = () => {
      const width = container.clientWidth
      const height = Math.max(container.clientHeight, 860)

      const objects = reasons.map((reason, index) => {
        return {
          id: reason.id,
          x: Math.random() * Math.max(1, width - BALL_SIZE),
          y: Math.random() * Math.max(1, height - BALL_SIZE),
          z: Math.random() * (MAX_Z - MIN_Z) + MIN_Z,
          vx: (Math.random() * 0.85 + 0.32) * (Math.random() > 0.5 ? 1 : -1),
          vy: (Math.random() * 0.85 + 0.32) * (Math.random() > 0.5 ? 1 : -1),
          vz: (Math.random() * 0.46 + 0.16) * (Math.random() > 0.5 ? 1 : -1),
          angle: Math.random() * 360,
          rotationSpeed: (Math.random() * 0.9 + 0.22) * (Math.random() > 0.5 ? 1 : -1),
          baseScale: 0.78 + Math.random() * 0.12,
          el: itemRefs.current[index],
        }
      })

      objectsRef.current = objects
    }

    const resolveCollisions = (objects) => {
      for (let i = 0; i < objects.length; i++) {
        for (let j = i + 1; j < objects.length; j++) {
          const a = objects[i]
          const b = objects[j]

          const ax = a.x + RADIUS
          const ay = a.y + RADIUS
          const bx = b.x + RADIUS
          const by = b.y + RADIUS

          const dx = bx - ax
          const dy = by - ay
          const dist = Math.sqrt(dx * dx + dy * dy)
          const minDist = BALL_SIZE - 8

          if (dist > 0 && dist < minDist) {
            const nx = dx / dist
            const ny = dy / dist
            const overlap = minDist - dist

            a.x -= nx * (overlap / 2)
            a.y -= ny * (overlap / 2)
            b.x += nx * (overlap / 2)
            b.y += ny * (overlap / 2)

            const tempVx = a.vx
            const tempVy = a.vy

            a.vx = b.vx + (Math.random() - 0.5) * 0.08
            a.vy = b.vy + (Math.random() - 0.5) * 0.08
            b.vx = tempVx + (Math.random() - 0.5) * 0.08
            b.vy = tempVy + (Math.random() - 0.5) * 0.08

            const tempVz = a.vz
            a.vz = b.vz
            b.vz = tempVz
          }
        }
      }
    }

    const animate = () => {
      if (selectedReasonRef.current) {
        animationRef.current = requestAnimationFrame(animate)
        return
      }

      const width = container.clientWidth
      const height = Math.max(container.clientHeight, 860)
      const objects = objectsRef.current

      objects.forEach((obj) => {
        obj.vx += (Math.random() - 0.5) * JITTER
        obj.vy += (Math.random() - 0.5) * JITTER

        obj.vx = clampSpeed(obj.vx, MAX_SPEED)
        obj.vy = clampSpeed(obj.vy, MAX_SPEED)

        obj.x += obj.vx
        obj.y += obj.vy
        obj.z += obj.vz
        obj.angle += obj.rotationSpeed

        if (obj.x <= 0) {
          obj.x = 0
          obj.vx = Math.abs(obj.vx)
        }

        if (obj.x >= width - BALL_SIZE) {
          obj.x = width - BALL_SIZE
          obj.vx = -Math.abs(obj.vx)
        }

        if (obj.y <= 0) {
          obj.y = 0
          obj.vy = Math.abs(obj.vy)
        }

        if (obj.y >= height - BALL_SIZE) {
          obj.y = height - BALL_SIZE
          obj.vy = -Math.abs(obj.vy)
        }

        if (obj.z <= MIN_Z) {
          obj.z = MIN_Z
          obj.vz = Math.abs(obj.vz)
        }

        if (obj.z >= MAX_Z) {
          obj.z = MAX_Z
          obj.vz = -Math.abs(obj.vz)
        }
      })

      resolveCollisions(objects)

      objects.forEach((obj) => {
        if (!obj.el) return

        const depthRatio = (obj.z - MIN_Z) / (MAX_Z - MIN_Z)
        const depthScale = obj.baseScale + depthRatio * 0.42
        const brightness = 0.82 + depthRatio * 0.34
        const saturate = 0.94 + depthRatio * 0.3
        const opacity = 0.7 + depthRatio * 0.3

        obj.el.style.transform = `translate3d(${obj.x}px, ${obj.y}px, ${obj.z}px) rotate(${obj.angle}deg) scale(${depthScale})`
        obj.el.style.zIndex = String(20 + Math.round(obj.z))
        obj.el.style.filter = `brightness(${brightness}) saturate(${saturate})`
        obj.el.style.opacity = String(opacity)
      })

      animationRef.current = requestAnimationFrame(animate)
    }

    createObjects()
    animationRef.current = requestAnimationFrame(animate)

    const handleResize = () => {
      cancelAnimationFrame(animationRef.current)
      createObjects()
      animationRef.current = requestAnimationFrame(animate)
    }

    window.addEventListener('resize', handleResize)

    return () => {
      cancelAnimationFrame(animationRef.current)
      window.removeEventListener('resize', handleResize)
    }
  }, [reasons])

  const handlePointerMove = (event) => {
    const rect = event.currentTarget.getBoundingClientRect()
    const px = (event.clientX - rect.left) / rect.width
    const py = (event.clientY - rect.top) / rect.height

    setTilt({
      x: Number((((0.5 - py) * 8) + 8).toFixed(2)),
      y: Number((((px - 0.5) * 12)).toFixed(2)),
    })
  }

  const resetTilt = () => {
    setTilt({ x: 10, y: -6 })
  }

  const openReason = (event, reason) => {
    event.preventDefault()
    event.stopPropagation()
    setSelectedReason(reason)
  }

  return (
    <section className="section reasons-section" id="razones">
      <SectionTitle
        eyebrow="100 razones"
        title="Ale, aquí dejé flotando 100 razones por las que te amo"
        text="Quise que no estuvieran quietas ni planas, sino vivas, moviéndose por todas partes, como si incluso mis razones para amarte tuvieran gravedad propia."
      />

      <div
        className="reasons-chaos-shell fade-up space-3d-reasons"
        style={{
          '--reasons-tilt-x': `${tilt.x}deg`,
          '--reasons-tilt-y': `${tilt.y}deg`,
        }}
        onPointerMove={handlePointerMove}
        onPointerLeave={resetTilt}
      >
        <div className="reasons-depth-stage">
          <div className="reasons-nebula reasons-nebula-a"></div>
          <div className="reasons-nebula reasons-nebula-b"></div>

          <div className="reasons-starfield" aria-hidden="true">
            {stars.map((star) => (
              <span
                key={star.id}
                className="reasons-star"
                style={{
                  left: star.left,
                  top: star.top,
                  width: star.size,
                  height: star.size,
                  animationDelay: star.delay,
                  animationDuration: star.duration,
                }}
              />
            ))}
          </div>

          <div className="reasons-chaos-box" ref={containerRef}>
            {reasons.map((reason, index) => (
              <button
                className="reason-heart chaotic-heart hyper-chaotic-heart"
                key={reason.id}
                ref={(el) => {
                  itemRefs.current[index] = el
                }}
                onPointerDown={(event) => openReason(event, reason)}
                title={reason.title}
                type="button"
              >
                <Heart size={18} />
                <span>{reason.id}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      {selectedReason && (
        <div className="reason-modal-backdrop" onPointerDown={() => setSelectedReason(null)}>
          <article className="reason-modal reason-modal-3d" onPointerDown={(event) => event.stopPropagation()}>
            <button className="reason-close" type="button" onPointerDown={() => setSelectedReason(null)}>
              <X size={18} />
            </button>

            <div className="reason-modal-heart">
              <Heart size={34} />
            </div>

            <span>{selectedReason.title}</span>
            <h3>{selectedReason.text}</h3>

            <button className="main-button" type="button" onPointerDown={() => setSelectedReason(null)}>
              Cerrar
            </button>
          </article>
        </div>
      )}
    </section>
  )
}

export default ReasonsSection
