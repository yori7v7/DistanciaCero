# Safe template only. Put real public client values in .env.local.
# Do not commit .env.local or any privileged server credentials.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional compatibility alias. Prefer VITE_SUPABASE_PUBLISHABLE_KEY for new code.
VITE_SUPABASE_ANON_KEY=

# Remote content must remain disabled until every readiness gate is approved.
VITE_REMOTE_CONTENT_ENABLED=false
